# Playwright
playwright-report/
test-results/
.playwright-cache/
# The Playwright MCP drops console logs and page snapshots into the cwd of every
# agent session. `*.log` already hid the logs; the `page-*.yml` snapshots kept
# surfacing as untracked litter in the main checkout.
.playwright-mcp/
storybook-static/

# Next.js
.next
out
.next/cache
.vercel
.turbo
# Regenerated by every `next dev` / `next build` / `next typegen`, and the two
# commands write different contents, so tracking it dirtied the tree on each run.
# Next's own docs say not to version it; `tsc` passes without it.
next-env.d.ts

# Production
dist
dist-ssr
build

# Environment variables
# Every env file is a secret until proven otherwise. Listing variants one by
# one left `.env.production`, `.env.development` and `.env.test` addable; the
# two templates are the only env files this repository tracks.
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo
*.tsbuildinfo.*

# Claude Code
# Local settings stay out; the project's own skills are versioned, so each one
# is re-included explicitly. Personal and plugin-installed skills land in
# .claude/skills/ too, which is why the default is ignore-everything.
.claude/*
# settings.json carries the shared PostToolUse lint hook, so it is part of the
# project standard rather than a personal preference; settings.local.json stays
# ignored by the rule above.
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/afrik-art-director/
!.claude/skills/afrik-game-designer/
!.claude/skills/ethniafrica-audience-audit/
!.claude/skills/ethniafrica-audit/
!.claude/skills/ethniafrica-bootstrap-confluence/
!.claude/skills/ethniafrica-content-strategist/
!.claude/skills/ethniafrica-essai/
!.claude/skills/ethniafrica-infra/
!.claude/skills/ethniafrica-experience-optimizer/
!.claude/skills/ethniafrica-release/
!.claude/skills/ethniafrica-spec/
!.claude/skills/ethniafrica-ticket/
.entire/

