    "check:workflow-shell": "tsx scripts/checkWorkflowShellSyntax.ts",
    "confluence:bootstrap:build": "tsx scripts/buildConfluenceBootstrap.ts",
    "dev": "next dev",
    "docs:index": "tsx scripts/ci/checkOrphanDocs.ts --write",
    "e2e": "playwright test",
    "e2e:debug": "playwright test --debug",
    "e2e:headed": "playwright test --headed",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:report": "playwright show-report playwright-report",
    "e2e:smoke": "playwright test --project=mobile-430 --grep @smoke",
    "e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check --cache --cache-strategy content .",
    "integration-tests": "vitest run --dir src/app/api",
    "lint": "eslint --cache --cache-strategy content --cache-location node_modules/.cache/eslint-src-scripts src scripts",
    "lint:fix": "npm run lint -- --fix",
    "lint:req": "tsx scripts/lintReqAnnotations.ts",
    "lint:req:staged": "tsx scripts/lintReqAnnotations.ts --staged",
    "migrations:diff": "tsx scripts/migrationsDiff.ts",
    "openapi:diff": "tsx scripts/openapi-diff.ts",
    "openapi:generate": "tsx scripts/generate-openapi-spec.ts",
    "prepare": "husky",
    "skills:link": "tsx scripts/setupAgentSkillLinks.ts",
    "start": "next start",
    "storybook": "storybook dev -p 6006",
    "test": "vitest run",
    "test:a11y": "npx playwright install chromium && tsx scripts/a11y-test.ts",
    "test:charter-contracts": "tsx scripts/runCharterContracts.ts",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "type-check": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "unit-tests": "vitest run --dir src/lib",
    "worktree:setup": "bash scripts/setup-worktree.sh",
    "check:editorial": "tsx scripts/ci/checkPlainLanguage.ts",
    "audit:editorial": "tsx scripts/ci/checkPlainLanguage.ts --audit",
    "check:publication": "tsx scripts/ci/checkPlainLanguage.ts --strict",
    "editorial:version": "vale --version",
    "social:render": "node social/renderer/render.mjs",
    "social:check-design": "node social/renderer/fidelity.mjs",
    "test:social-renderer": "node --test social/renderer/*.test.mjs",
    "test:social-series-proposal": "node --test social/design-system/proposals/1.3.0-proposition/*.test.mjs",
    "test:social-video": "node --test social/video/sequence.test.mjs social/video/chunks.test.mjs social/video/area-entries.test.mjs social/video/capture.test.mjs social/video/shoreline.test.mjs social/video/areas.test.mjs social/video/voiced.test.mjs social/video/voice.test.mjs social/video/series.test.mjs social/video/series-map.test.mjs social/video/series-sequence.test.mjs social/video/series-long.test.mjs social/video/series-documents.test.mjs social/video/series.render.test.mjs social/video/series-long.render.test.mjs social/video/series-documents.render.test.mjs social/video/series-legibility.render.test.mjs",
    "test:social-video-acceptance": "node --test social/video/*.test.mjs",
    "social:package": "node .claude/skills/ethniafrica-social-production/scripts/package.mjs",
    "social:research": "node .claude/skills/ethniafrica-social-production/scripts/research.mjs",
    "test:social-production": "node --test .claude/skills/ethniafrica-social-production/scripts/*.test.mjs",
    "test:social-clip": "node --test .claude/skills/ethniafrica-reel-clip/scripts/*.test.mjs"
  },
