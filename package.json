{
  "name": "ethniafrica",
  "private": true,
  "version": "5.5.0",
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "all-tests": "vitest run",
    "api-tests": "vitest run --dir src/app/api/v2",
    "audit:people-sources": "tsx scripts/audit/runPeopleSourceTierAudit.ts",
    "build": "next build",
    "build-storybook": "storybook build",
    "bundle-size:axis-graph": "tsx scripts/axis-graph-bundle-size.ts",
    "bundle-size:home-globe": "tsx scripts/home-globe-bundle-size.ts",
    "bundle-size:quiz": "tsx scripts/quiz-bundle-size.ts",
    "bundle-size:embed-facade": "tsx scripts/embed-facade-bundle-size.ts",
    "check:action-pins": "tsx scripts/checkGithubActionPins.ts",
    "check:ai-sources": "tsx scripts/ci/checkAiGeneratedSources.ts",
    "verify:ai-sources": "tsx scripts/afrik/verifyAiGeneratedSources.ts",
    "check:asset-weight": "tsx scripts/ci/checkPublicAssetWeight.ts",
    "check:copy-literals": "tsx scripts/ci/checkCopyLiterals.ts",
    "check:dead": "tsx scripts/ci/checkDeadCode.ts",
    "check:embed-availability": "tsx scripts/checkEmbedAvailability.ts",
    "check:etymology-hypotheses": "tsx scripts/ci/checkEtymologyHypotheses.ts",
    "check:env-example": "tsx scripts/checkEnvExample.ts",
    "check:infra-disclosure": "tsx scripts/ci/checkInfraDisclosure.ts",
    "check:jira-template": "tsx scripts/checkJiraTemplate.ts",
    "check:local-paths": "tsx scripts/ci/checkLocalPaths.ts --selftest && tsx scripts/ci/checkLocalPaths.ts",
    "check:migration-files": "tsx scripts/ci/checkMigrationState.ts --files-only",
    "check:migration-state": "tsx scripts/ci/checkMigrationState.ts",
    "check:migration-state:production": "tsx scripts/ci/checkMigrationState.ts --target=production",
    "check:orphan-docs": "tsx scripts/ci/checkOrphanDocs.ts",
    "check:pagination-contract": "tsx scripts/checkPaginationContractDrift.ts",
    "check:production-ledger": "tsx scripts/ci/checkProductionLedger.ts --selftest && tsx scripts/ci/checkProductionLedger.ts",
    "check:rls-coverage": "tsx scripts/ci/checkRlsCoverage.ts",
    "check:skill-parity": "tsx scripts/ci/checkSkillParity.ts",
    "check:source-kinds": "tsx scripts/ci/checkSourceKindCoverage.ts",
    "report:name-history-waves": "tsx scripts/afrik/nameHistoryWaveOrder.ts",
