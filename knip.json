{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,loading,error,global-error,not-found,template,default,forbidden,unauthorized,route,sitemap,robots,manifest,icon,apple-icon,opengraph-image,twitter-image}.{ts,tsx}!",
    "src/{proxy,instrumentation,instrumentation-client}.ts!",
    "{next,tailwind}.config.ts!",
    ".lighthouserc.js",
    ".storybook/{main,preview}.ts",

    "**/*.{test,stories}.{ts,tsx}",
    "**/__tests__/**/*.{ts,tsx}",
    "eslint/**/*.js",

    "scripts/**/*.{ts,mjs,cjs}!",
    "e2e/**/*.ts",
    "src/test/resolveAsyncServerComponents.tsx",
    "src/lib/search/resultGrammar.ts!",
    "src/lib/search/__fixtures__/*.ts!",
    "src/components/search/answer/__fixtures__/*.tsx!",
    "src/lib/atlas/assets/generate-*.mjs!",
    "supabase/functions/**/index.ts!",
    "docs/design/mockups/**/*.{js,css}"
  ],
  "project": [
    "src/**/*.{ts,tsx}!",
    "!src/components/fiche/ficheStoryViewports.ts!",
    "!src/test/**!",
    "{next,tailwind}.config.ts!",
    "scripts/**/*.{ts,mjs}!",
    "e2e/**/*.ts"
  ],
  "tailwind": { "entry": ["tailwind.config.ts!"] },
  "ignoreDependencies": [
    "puppeteer",
    // The default run hints this is redundant, but `knip --production` does
    // not follow tailwind.config.ts and reports it unused without this line.
    "tailwindcss-animate"
  ],
  "ignoreBinaries": [
    // System tools the video scripts and tests run through node:child_process,
    // which knip 6 now reads; they come from the OS, never from an npm package.
    "ffmpeg",
    "ffprobe"
  ],
  "ignoreExportsUsedInFile": true
}
